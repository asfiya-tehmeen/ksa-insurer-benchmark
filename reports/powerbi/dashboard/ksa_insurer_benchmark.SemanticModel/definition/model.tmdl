model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFolder","dim_insurer","dim_period","fact_insurer_period"]

annotation PBI_ProTooling = ["DevMode"]

ref table dim_insurer
ref table dim_period
ref table fact_insurer_period

ref cultureInfo en-US

